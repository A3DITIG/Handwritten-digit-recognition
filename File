import cv2
import matplotlib.pyplot as plt
from google.colab import files
from paddleocr import PaddleOCR, draw_ocr
from PIL import Image
import numpy as np

# Initialize OCR (GPU enabled)
ocr = PaddleOCR(use_angle_cls=True, lang='en', use_gpu=True)

# Upload image
uploaded = files.upload()
img_path = list(uploaded.keys())[0]

# Read image
img = cv2.imread(img_path)
img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)

plt.imshow(img_rgb)
plt.axis("off")
plt.title("Uploaded Image")

# Run OCR
result = ocr.ocr(img_path)

print("\nExtracted Text:\n")

texts = []
boxes = []

for line in result:
    for word in line:
        bbox, (text, score) = word
        texts.append(text)
        boxes.append(bbox)
        print(f"{text}   (confidence={round(score,2)})")

# Draw bounding boxes
image = Image.open(img_path).convert("RGB")
boxes_np = [np.array(box).astype(int) for box in boxes]

im_show = draw_ocr(image, boxes_np, texts)
im_show = Image.fromarray(im_show)

plt.figure(figsize=(10,10))
plt.imshow(im_show)
plt.axis("off")
plt.title("Detected Text Regions")

